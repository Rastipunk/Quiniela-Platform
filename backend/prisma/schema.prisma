// =========================================================================
// CORPORATE / ENTERPRISE - Organizaciones y consultas empresariales
// =========================================================================

enum OrganizationStatus {
  INQUIRY // Empresa contactó vía formulario
  ONBOARDING // Admin está configurando
  ACTIVE // Operacional
  SUSPENDED // Suspendida temporalmente
}

model Organization {
  id                String             @id @default(uuid())
  // Nota: name no es único — diferentes empresas pueden compartir nombre
  name              String
  contactEmail      String
  contactName       String
  contactPhone      String?
  logoUrl           String? // URL externa al logo (admin la pone manualmente)
  logoBase64        String? // Logo en base64 (como BetaFeedback.imageBase64)
  website           String?
  employeeCount     String? // Rango: "1-50", "51-200", "201-500", "500+"
  welcomeMessage    String?            @db.Text // Se muestra en el splash del pool
  invitationMessage String?            @db.Text // Se incluye en el email de invitación
  // Custom branding colors (hex #RRGGBB). Optional — when null the
  // pool splash/header/email fall back to the Picks4All default
  // gradient. Set during corporate pool creation and editable later
  // from the admin panel.
  primaryColor      String? // #RRGGBB
  secondaryColor    String? // #RRGGBB
  notes             String?            @db.Text
  status            OrganizationStatus @default(INQUIRY)

  inquiries OrganizationInquiry[]
  pools     Pool[]

  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt

  @@index([status])
}

model OrganizationInquiry {
  id String @id @default(uuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  companyName   String
  contactName   String
  contactEmail  String
  contactPhone  String?
  employeeCount String?
  message       String? @db.Text
  locale        String  @default("es")

  // Quote-specific fields populated by the /empresas quote panel.
  // Optional because the legacy inquiry path (employeeCount tier) doesn't
  // capture them. Country uses ISO 3166-1 alpha-2 (e.g. "CO", "AR").
  country       String?
  currency      String?
  numberOfPools Int?
  slotsPerPool  Int?
  // JSON-encoded array of slot counts, one entry per pool requested.
  // Lets the requester ask for several pools of different sizes
  // (e.g. [50, 80, 30] for marketing/sales/HR). When all entries are
  // identical, slotsPerPool is also populated for backwards-compatible
  // querying; when heterogeneous, slotsPerPool is null and this column
  // is the source of truth.
  poolsConfigJson String?

  responded   Boolean   @default(false)
  respondedAt DateTime?

  createdAtUtc DateTime @default(now())

  @@index([responded])
  @@index([createdAtUtc])
}

// =========================================================================
// CORPORATE INVITES - Invitaciones a empleados para pools corporativas
// =========================================================================

enum CorporateInviteStatus {
  PENDING // Email validado, esperando envío
  SENT // Invitation email enviado
  ACTIVATED // Usuario creó cuenta y entró al pool
  FAILED // Error al enviar email
}

model CorporateInvite {
  id String @id @default(uuid())

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  email String
  name  String? // Opcional, del CSV

  // Token de activación (similar a emailVerificationToken)
  activationToken          String   @unique
  activationTokenExpiresAt DateTime // 30 días

  status CorporateInviteStatus @default(PENDING)

  // Después de activar
  activatedUserId String?
  activatedAt     DateTime?

  createdAtUtc DateTime @default(now())

  @@unique([poolId, email])
  @@index([activationToken])
  @@index([poolId])
  @@index([status])
}

// =========================================================================
// PAYMENTS — Polar.sh integration for pool capacity upgrades
// =========================================================================

enum PaymentStatus {
  PENDING // Checkout created, awaiting user action on Polar
  COMPLETED // Polar webhook confirmed payment (order.paid)
  FAILED // Payment failed, expired, or was abandoned
  REFUNDED // Refund issued via Polar dashboard
}

model PoolPayment {
  id String @id @default(uuid())

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Polar identifiers for idempotency and reconciliation
  polarCheckoutId String  @unique // Checkout session ID from Polar
  polarOrderId    String? @unique // Order ID set by webhook on confirmation

  status    PaymentStatus @default(PENDING)
  amountUsd Int // Amount in USD cents (e.g. 799 = $7.99). Stored for ALL
  // gateways so the platform has a unified USD figure. For COP payments
  // this is the USD equivalent at checkout time; the real pesos paid live
  // in `amountCop`.
  /// Actual COP amount paid, in whole pesos (Mercado Pago has no sub-unit).
  /// Null for non-MP payments. Use this when reporting Purchase `value` to
  /// GA4/Meta so revenue dashboards reflect what the customer really paid,
  /// not the USD cents equivalent.
  amountCop Int?
  currency  String        @default("usd")

  // Capacity change this payment covers
  fromCapacity Int // maxParticipants before payment
  toCapacity   Int // maxParticipants after payment
  poolType     String // "personal" | "corporate"

  // Unique event ID used to deduplicate Meta Pixel (browser) against Meta
  // CAPI (server). Generated once when the payment is approved and used
  // for BOTH emissions. Also reported back to the client so the exitoso
  // page can re-emit the pixel event with the same ID without duplicating.
  metaEventId String?

  // Meta Advanced Matching signals captured at checkout creation so the
  // ASYNCHRONOUS webhook path (Polar, MP IPN) can still emit CAPI events
  // with a high EMQ score. Browser-side Purchase already has these on
  // the Pixel side; without persisting them here the server-side failsafe
  // would match with only email/name and lose ~2-3 EMQ points.
  metaFbp         String? // `_fbp` cookie captured at checkout init
  metaFbc         String? // `_fbc` cookie captured at checkout init
  clientIpAddress String? // Remote IP at checkout init (for GEO + EMQ)
  clientUserAgent String? // UA at checkout init (for EMQ)

  paidAtUtc    DateTime?
  createdAtUtc DateTime  @default(now())
  updatedAtUtc DateTime  @updatedAt

  @@index([poolId])
  @@index([userId])
  @@index([status])
}

// Immutable audit log of every webhook event received from Polar
model PaymentEvent {
  id String @id @default(uuid())

  polarEventId String @unique // Polar's event ID for deduplication
  eventType    String // e.g. "order.paid", "checkout.updated"
  payloadJson  Json // Full webhook payload for debugging/replay

  processedAtUtc DateTime @default(now())
  createdAtUtc   DateTime @default(now())

  @@index([polarEventId])
}

/// Dead-letter queue for Meta Conversion API events that fail after all
/// in-process retries. A background worker re-attempts delivery with
/// the SAME event_id so re-sends never produce duplicates downstream.
/// Provider column discriminates the target sink (Meta CAPI, GA4 MP…).
model FailedAnalyticsEvent {
  id String @id @default(uuid())

  /// Target sink: "META_CAPI" | "GA4_MP". Kept as String so adding a new
  /// provider is an additive change rather than an enum migration.
  provider String @default("META_CAPI")

  eventName   String // e.g. "Purchase", "CompleteRegistration", "refund"
  eventId     String // stable id used to dedupe at the sink
  payloadJson Json // full POST body we tried to send (no secrets)

  attemptCount  Int       @default(1)
  lastError     String    @db.Text
  lastAttemptAt DateTime  @default(now())
  // When a worker should next retry. Null while being processed.
  nextRetryAt   DateTime?

  // Resolved / expired rows are kept briefly for forensics then purged.
  resolvedAt   DateTime?
  createdAtUtc DateTime  @default(now())
  updatedAtUtc DateTime  @updatedAt

  @@index([provider, nextRetryAt, resolvedAt])
  @@index([eventId])
}
