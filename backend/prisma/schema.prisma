// =========================================================================
// BRANDING AUDIT — every host-driven branding change is logged so we can
// trace who changed what and when. Required because branding edits affect
// what employees see in their splash/emails (legal/compliance trail).
// =========================================================================

model OrganizationBrandingAudit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // The user who triggered the change (host or co-admin of a pool that
  // belongs to the organization). Platform admin edits go through the
  // admin panel and aren't tracked here.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  changedAt DateTime @default(now())

  // Names of the org fields that changed in this update. Stored as a
  // string array so reports/UI can group by "edited colors", "edited
  // welcome message", etc. Possible values: "logoBase64",
  // "primaryColor", "secondaryColor", "welcomeMessage", "invitationMessage".
  fieldsChanged String[]

  // Snapshots of the changed fields only — keeps logs compact and
  // makes reverts trivial. Each is a JSON object keyed by field name.
  beforeJson Json
  afterJson  Json

  // Forensic context. Both nullable: trust-proxy and UA detection are
  // best-effort and we never want a missing IP to block a legitimate
  // edit.
  ipAddress String?
  userAgent String?

  @@index([organizationId, changedAt])
  @@index([userId, changedAt])
}

model OrganizationInquiry {
  id String @id @default(uuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  companyName   String
  contactName   String
  contactEmail  String
  contactPhone  String?
  employeeCount String?
  message       String? @db.Text
  locale        String  @default("es")

  // Quote-specific fields populated by the /empresas quote panel.
  // Optional because the legacy inquiry path (employeeCount tier) doesn't
  // capture them. Country uses ISO 3166-1 alpha-2 (e.g. "CO", "AR").
  country         String?
  currency        String?
  numberOfPools   Int?
  slotsPerPool    Int?
  // JSON-encoded array of slot counts, one entry per pool requested.
  // Lets the requester ask for several pools of different sizes
  // (e.g. [50, 80, 30] for marketing/sales/HR). When all entries are
  // identical, slotsPerPool is also populated for backwards-compatible
  // querying; when heterogeneous, slotsPerPool is null and this column
  // is the source of truth.
  poolsConfigJson String?

  responded   Boolean   @default(false)
  respondedAt DateTime?

  createdAtUtc DateTime @default(now())

  @@index([responded])
  @@index([createdAtUtc])
}

