// =========================================================================
// PAYMENTS — Polar.sh integration for pool capacity upgrades
// =========================================================================

enum PaymentStatus {
  // Order matches the lifecycle a payment can flow through. New values are
  // appended in PG migrations to preserve the existing enum ordering on disk.
  // See `20260519_extend_payment_observability/migration.sql`.
  INITIATED // Row inserted before calling the gateway. If the gateway call
  //          fails the row stays INITIATED and is later swept by the
  //          reconciler (F-4 fix). Distinguishes "we never reached the
  //          gateway" from "user is on the gateway page (PENDING)".
  PENDING // Checkout created on Polar/MP, awaiting user action on the
  //         gateway page
  COMPLETED // Gateway webhook confirmed payment (Polar order.paid or
  //          MP approved)
  FAILED // Gateway explicitly rejected / failed the payment
  ABANDONED // Reconciler swept a stale PENDING/INITIATED with no
  //           gateway-side signal for > N hours. Distinct from EXPIRED
  //           because we don't have an explicit gateway expiration event.
  EXPIRED // Gateway told us the checkout expired (e.g. Polar
  //         checkout.updated status=expired)
  CANCELLED // User explicitly cancelled at the gateway page (Polar
  //           order.canceled or MP cancelled)
  REFUNDED // Refund processed by the gateway after a COMPLETED payment
}

model PoolPayment {
  id String @id @default(uuid())

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Polar identifiers for idempotency and reconciliation.
  // polarCheckoutId is nullable to support the INITIATED state: the row
  // is written BEFORE we call Polar so a gateway-side failure still
  // leaves a trail. Once Polar accepts, this is updated to the real
  // checkout ID and status flips to PENDING. Uniqueness is enforced by
  // the partial unique index `PoolPayment_polarCheckoutId_unique_when_set`
  // (UNIQUE WHERE polarCheckoutId IS NOT NULL) — see migration 20260521.
  polarCheckoutId String? // populated after Polar accepts the checkout; NULL while INITIATED
  polarOrderId    String? @unique // Order ID set by webhook on confirmation

  status    PaymentStatus @default(PENDING)
  amountUsd Int // Amount in USD cents (e.g. 799 = $7.99). Stored for ALL
  // gateways so the platform has a unified USD figure. For COP payments
  // this is the USD equivalent at checkout time; the real pesos paid live
  // in `amountCop`.
  /// Actual COP amount paid, in whole pesos (Mercado Pago has no sub-unit).
  /// Null for non-MP payments. Use this when reporting Purchase `value` to
  /// GA4/Meta so revenue dashboards reflect what the customer really paid,
  /// not the USD cents equivalent.
  amountCop Int?
  currency  String        @default("usd")

  // Capacity change this payment covers
  fromCapacity Int // maxParticipants before payment
  toCapacity   Int // maxParticipants after payment
  poolType     String // "personal" | "corporate"

  // Unique event ID used to deduplicate Meta Pixel (browser) against Meta
  // CAPI (server). Generated once when the payment is approved and used
  // for BOTH emissions. Also reported back to the client so the exitoso
  // page can re-emit the pixel event with the same ID without duplicating.
  metaEventId String?

  // Meta Advanced Matching signals captured at checkout creation so the
  // ASYNCHRONOUS webhook path (Polar, MP IPN) can still emit CAPI events
  // with a high EMQ score. Browser-side Purchase already has these on
  // the Pixel side; without persisting them here the server-side failsafe
  // would match with only email/name and lose ~2-3 EMQ points.
  metaFbp         String? // `_fbp` cookie captured at checkout init
  metaFbc         String? // `_fbc` cookie captured at checkout init
  clientIpAddress String? // Remote IP at checkout init (for GEO + EMQ)
  clientUserAgent String? // UA at checkout init (for EMQ)

  // Mercado Pago preference ID (only set for MP/COP payments). Persisted so
  // that idempotent re-entries to initiateMpCheckout (e.g. host double-click)
  // can return the EXISTING preference instead of creating a second one and
  // racing the customer into paying twice. Polar uses polarCheckoutId for
  // the same purpose.
  mpPreferenceId String?

  // MP's real `payment.id`. Set on the first IPN delivery (defensive,
  // even on `pending` status) so the MP reconciler can call
  // `getPayment(mpPaymentId)` to resolve stuck rows. For legacy rows
  // (created before this column existed), the reconciler falls back to
  // MP's `payments/search` by external_reference (= polarCheckoutId).
  // See PAYMENTS_PARITY_AUDIT.md §3.6.
  mpPaymentId String?

  paidAtUtc    DateTime?
  createdAtUtc DateTime  @default(now())
  updatedAtUtc DateTime  @updatedAt

  // Audit trail. See PaymentEvent for the source / eventType taxonomy.
  events PaymentEvent[]

  // Optional 1:1 link to the AccountReceivable (cuenta de cobro) this
  // payment fulfilled. Set when the customer redeemed a CC code during
  // checkout (see SALES_AUDIT.md §9.7). Nullable for payments without a
  // CC. Unique so a given CC is paid exactly once.
  accountReceivableId String?            @unique
  accountReceivable   AccountReceivable? @relation(fields: [accountReceivableId], references: [id])

  @@index([poolId])
  @@index([userId])
  @@index([status])
  // Compound index for both reconcilers' stale-row queries:
  //   WHERE status IN (...) AND createdAtUtc < cutoff
  // Polar reconciler uses it via `findStalePayments`; MP reconciler
  // (added in commit 5 of this cycle) uses the same pattern. Single
  // index covers both. See PAYMENTS_PARITY_AUDIT.md §3.5.
  @@index([status, createdAtUtc])
}

// Immutable audit log of every payment-related event we observe.
// Originally Polar-webhook only; extended in 20260519 to cover MP webhooks,
// client-side beacons (REDIRECT_INITIATED, USER_CANCELLED, CLIENT_ERROR),
// reconciler-issued transitions, and any future channel.
// See ADR-060 (POLAR_AUDIT.md F-3, F-13, F-17).
model PaymentEvent {
  id String @id @default(uuid())

  /// Origin of the event. Must be one of the values in EVENT_SOURCES
  /// (backend/src/lib/paymentEventSources.ts). Persisted as TEXT (not
  /// enum) so adding a new source is an additive change, not a migration.
  /// Allowed values today:
  ///   - POLAR_WEBHOOK   — received from Polar's signed webhook
  ///   - MP_WEBHOOK      — received from Mercado Pago IPN
  ///   - CLIENT          — beacon from the browser (redirect, cancel, error)
  ///   - RECONCILER      — written by the periodic reconciler job
  ///   - SERVER          — internal state transition not tied to a webhook
  source String @default("POLAR_WEBHOOK")

  /// Gateway-issued event ID (Polar `webhook-id`-payload event id or MP
  /// composite). REQUIRED for POLAR_WEBHOOK / MP_WEBHOOK rows — they are
  /// the idempotency anchor that prevents duplicate processing per ADR-046.
  /// NULL for CLIENT / RECONCILER / SERVER rows (their identity is the
  /// row's own UUID `id`). A partial unique index in the DB enforces
  /// uniqueness only when this column is non-NULL — see
  /// `PaymentEvent_polarEventId_unique_when_set` in the 20260519 migration.
  polarEventId String?

  /// FK to the PoolPayment this event refers to. Always set for events
  /// produced after the 20260519 migration. Nullable to keep the 3
  /// legacy webhook rows valid until backfilled, and to allow ad-hoc
  /// reconciler events that touch multiple payments.
  /// ON DELETE SET NULL preserves the audit trail if a PoolPayment is
  /// ever hard-deleted (which we don't currently do).
  poolPaymentId String?
  poolPayment   PoolPayment? @relation(fields: [poolPaymentId], references: [id], onDelete: SetNull)

  /// Event taxonomy.
  ///   - Polar webhooks:   "order.paid", "order.refunded", "order.canceled",
  ///                       "checkout.created", "checkout.updated", ...
  ///   - MP IPN:           "mp.payment.updated"
  ///   - Client beacons:   "REDIRECT_INITIATED" | "REDIRECT_FAILED" |
  ///                       "USER_CANCELLED" | "CLIENT_ERROR"
  ///   - Reconciler:       "RECONCILER_ABANDONED" | "RECONCILER_EXPIRED" |
  ///                       "RECONCILER_RESCUED" | "RECONCILER_NOOP"
  ///   - Server:           "STATUS_TRANSITION"
  eventType String

  /// Polar webhook delivery headers, captured at receipt so we can cross-
  /// reference with Polar's dashboard when diagnosing missing or
  /// duplicate deliveries. Null for non-webhook events.
  webhookId        String?
  webhookTimestamp DateTime?

  /// Full payload for replay / forensics. For webhooks this is the
  /// gateway body verbatim. For client beacons this is the body the
  /// browser sent. For reconciler rows this is the snapshot the
  /// reconciler used to make its decision.
  payloadJson Json

  processedAtUtc DateTime @default(now())
  createdAtUtc   DateTime @default(now())

  @@index([polarEventId])
  @@index([poolPaymentId])
  @@index([source, eventType])
}

/// Dead-letter queue for Meta Conversion API events that fail after all
/// in-process retries. A background worker re-attempts delivery with
/// the SAME event_id so re-sends never produce duplicates downstream.
/// Provider column discriminates the target sink (Meta CAPI, GA4 MP…).
model FailedAnalyticsEvent {
  id String @id @default(uuid())

  /// Target sink: "META_CAPI" | "GA4_MP". Kept as String so adding a new
  /// provider is an additive change rather than an enum migration.
  provider String @default("META_CAPI")

  eventName   String // e.g. "Purchase", "CompleteRegistration", "refund"
  eventId     String // stable id used to dedupe at the sink
  payloadJson Json // full POST body we tried to send (no secrets)

  attemptCount  Int       @default(1)
  lastError     String    @db.Text
  lastAttemptAt DateTime  @default(now())
  // When a worker should next retry. Null while being processed.
  nextRetryAt   DateTime?

  // Resolved / expired rows are kept briefly for forensics then purged.
  resolvedAt   DateTime?
  createdAtUtc DateTime  @default(now())
  updatedAtUtc DateTime  @updatedAt

  @@index([provider, nextRetryAt, resolvedAt])
  @@index([eventId])
}

// =========================================================================
// SALES MANAGEMENT (admin-only)
// Three models that back the /admin/ventas/ panel:
//   - Quote               (cotización — pre-sale price quote)
//   - AccountReceivable   (cuenta de cobro — formal billing doc with a
//                          redemption code customers can use at checkout)
//   - DocumentCounter     (atomic per-year consecutive numbers)
// See SALES_AUDIT.md and SALES_IMPLEMENTATION.md for the full spec and
// the locked decisions (§11.1–§11.23). Single-currency per document
// (COP via Mercado Pago or USD via Polar); pricing always derived
// server-side from lib/pricing.ts.
// =========================================================================

model Quote {
  id String @id @default(uuid())

  // Numbering — assigned at issue time via DocumentCounter.
  consecutive String @unique // "COT-2026-0001"
  year        Int // for counter lookup
  number      Int // sequence within year

  // Client snapshot at issue time. Captured by value (not FK) because
  // the client is rarely a User of the platform — usually just a
  // company we're quoting.
  clientLegalName    String
  clientContactEmail String

  // Issuer snapshot — JSON copy of issuerInfo.ts at issue time so
  // previously-issued documents retain the legal data they were
  // signed with even if Juan Camilo updates his constant later.
  issuerSnapshotJson Json

  // Localization — admin picks per document.
  // locale: "es" | "en" | "pt"
  // term:   "polla" | "pool" | "prode" | "quiniela" | "bolão" | etc.
  //         Validated against the locale's allowed term list at the
  //         service layer (saleTerms.ts).
  locale String
  term   String

  // Investment block (single, no multi-option per §11.14).
  // amountCop / amountUsdCents are SERVER-DERIVED from pricing.ts —
  // admin never enters them. The pair is nullable per currency to
  // mirror PoolPayment's existing pattern (ADR-046: never mix units).
  participants          Int
  currency              String // "COP" | "USD"
  amountCop             Int?
  amountUsdCents        Int?
  perPersonAmount       Int // in the chosen currency's minor unit
  tournament            String?
  investmentDescription String? @db.Text

  // Dates.
  issueDate  DateTime @db.Date
  validUntil DateTime @db.Date

  // Layout.
  includeCoverPage Boolean @default(true)
  notes            String? @db.Text

  // Lifecycle.
  status QuoteStatus @default(ACTIVE)

  // Audit.
  createdByUserId String
  createdAtUtc    DateTime @default(now())
  updatedAtUtc    DateTime @updatedAt

  createdBy User                @relation(fields: [createdByUserId], references: [id])
  linkedCcs AccountReceivable[]

  @@index([consecutive])
  @@index([clientContactEmail])
  @@index([createdAtUtc])
}

enum QuoteStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model AccountReceivable {
  id String @id @default(uuid())

  // Numbering.
  consecutive String @unique // "CC-2026-0001"
  year        Int
  number      Int

  // Redemption code — 8-digit numeric (§11.3). Stored raw; UI/PDF
  // formats with hyphen as XXXX-XXXX. Customer types either form
  // (normalised in saleRedemption.ts before lookup).
  redemptionCode String @unique

  // Client snapshot.
  clientLegalName    String
  clientNit          String?
  clientContactEmail String
  clientCity         String?

  // Issuer snapshot — same shape as Quote.issuerSnapshotJson.
  issuerSnapshotJson Json

  // Localization.
  locale String
  term   String

  // Content.
  concept    String  @db.Text
  tournament String?
  notes      String? @db.Text

  // Pricing — server-derived, mirrors Quote (§11.20). Nullable per
  // currency. amountInWords localized at issue time using
  // numero-a-letras with locale-aware suffix.
  currency       String
  amountCop      Int?
  amountUsdCents Int?
  amountInWords  String
  // targetCapacity is the # of slots this CC pre-pays. At redemption
  // it locks the wizard's capacity to this value (§11.7 safeguard).
  targetCapacity Int
  poolType       String // "corporate" v1; future "personal" possible

  // Dates.
  issueDate  DateTime @db.Date
  validUntil DateTime @db.Date

  // Lifecycle — PENDING → REDEEMED → PAID. PENDING → EXPIRED when
  // validUntil passes without redemption. Any → CANCELLED via admin.
  status           AccountReceivableStatus @default(PENDING)
  redeemedAtUtc    DateTime?
  redeemedByUserId String?
  paidAtUtc        DateTime?

  // Cross-reference back to the optional Quote it originated from
  // (§11.5: docs are independent by default, but admin may link).
  linkedQuoteId String?

  // Forward link to the PoolPayment that consumed this CC. Set when
  // CC transitions to REDEEMED (inside paymentService.initiateCheckout
  // — see §9.7). UNIQUE so a CC can only fund one payment.
  poolPaymentId String? @unique

  // Audit.
  createdByUserId String
  createdAtUtc    DateTime @default(now())
  updatedAtUtc    DateTime @updatedAt

  createdBy   User         @relation("CreatedAccountReceivables", fields: [createdByUserId], references: [id])
  redeemedBy  User?        @relation("RedeemedAccountReceivables", fields: [redeemedByUserId], references: [id])
  linkedQuote Quote?       @relation(fields: [linkedQuoteId], references: [id])
  poolPayment PoolPayment?

  @@index([consecutive])
  @@index([redemptionCode])
  @@index([clientContactEmail])
  @@index([status, validUntil]) // for the expiry sweep job
}

enum AccountReceivableStatus {
  PENDING
  REDEEMED
  PAID
  EXPIRED
  CANCELLED
}

// Atomic per-year consecutive counter, keyed by (kind, year). Single
// row per kind/year combo; INSERT ... ON CONFLICT DO UPDATE used at
// the service layer (documentCounterService.ts) to atomically read +
// increment + return the next number inside one transaction.
model DocumentCounter {
  kind         DocumentKind
  year         Int
  lastNumber   Int          @default(0)
  updatedAtUtc DateTime     @updatedAt

  @@id([kind, year])
}

enum DocumentKind {
  QUOTE
  ACCOUNT_RECEIVABLE
}

// =========================================================================
// PLATFORM HEALTH - cron-driven monitoring (platformHealthJob)
// =========================================================================

/**
 * One row per active or recently-resolved (alertKey, severity) pair.
 * The cron upserts a row when a metric crosses into WARN/CRITICAL, sets
 * resolvedAt when it returns to OK, and uses notifiedAt to dedupe
 * outbound emails — one fire-email + one recovery-email per incident
 * regardless of cron tick frequency.
 */
model PlatformHealthAlert {
  id String @id @default(uuid())

  // Stable identifier of the metric (e.g. "db_connections", "event_loop_lag").
  alertKey String

  severity PlatformHealthSeverity

  // Numeric value at first observation (% for ratios, ms for durations, count for sizes).
  observedValue Float

  // Threshold the value crossed.
  threshold Float

  // Human-readable snapshot included verbatim in the alert email.
  details String?

  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())

  // Set when the alert email was last sent. Re-sends suppressed while
  // (now - notifiedAt) < ALERT_COOLDOWN_HOURS.
  notifiedAt DateTime?

  // Set on the tick where the metric returns to OK.
  resolvedAt DateTime?

  // Set when the recovery email was sent (avoids re-sending recovery).
  resolutionNotifiedAt DateTime?

  // (alertKey, severity, resolvedAt) — only one OPEN row per (key,sev)
  // because Postgres treats NULL as distinct. Historical resolved rows
  // accumulate (different resolvedAt values), supplying a permanent
  // audit trail.
  @@unique([alertKey, severity, resolvedAt])
  @@index([alertKey])
  @@index([resolvedAt])
}

enum PlatformHealthSeverity {
  WARN
  CRITICAL
}
